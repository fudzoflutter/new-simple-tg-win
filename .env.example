# Copy this file to ".env" and fill in your values.
# On Windows (cmd):        copy .env.example .env
# On Linux / macOS:        cp .env.example .env

# --- REQUIRED ---------------------------------------------------------------
# Token of YOUR bot (the bot that users connect via Telegram Business).
# Get it from @BotFather -> /mybots -> API Token.
BOT_TOKEN=123456789:AAF...your-token-here

# Your personal Telegram numeric ID (the bot owner / main admin).
# Get it from @userinfobot or @getmyid_bot.
ADMIN_ID=123456789

# --- RECOMMENDED: Supabase Postgres (cloud storage) --------------------------
# Supabase Dashboard -> Connect -> "Connection pooling" -> copy URI:
# SUPABASE_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# If left empty, the bot automatically falls back to the local SQLite file
# below (works fine for testing; data will not be in Supabase).

# --- OPTIONAL ---------------------------------------------------------------
# Local fallback database file (created automatically).
DB_PATH=bot.db

# Custom emoji IDs for premium buttons / message icons. Leave empty to use
# built-in defaults; see app/config.py for the full list of keys.
EMOJI_ID_STATS=
EMOJI_ID_PREMIUM=
EMOJI_ID_CONNECT=
